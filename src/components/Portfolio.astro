---
import { projects } from "../data/projects";
// An original continuous brush route; its broad stroke covers the complete 600 × 800 canvas.
const brush = "M 650 -180 C 570 -90, 20 20, 50 110 S 660 180, 550 310 S -50 360, 50 490 S 650 550, 550 670 S -30 760, 30 970";
---
<section class="portfolio-section" id="portfolio" aria-labelledby="portfolio-title">
	<header class="portfolio-heading">
		<h2 id="portfolio-title">Idee, in pratica.</h2>
		<p>Tre modi diversi di dare forma a un progetto.<br />Concept dimostrativi, non lavori per clienti reali.</p>
	</header>
	<div class="portfolio-grid">
		{projects.map((project, index) => (
			<figure class:list={["portfolio-project", project.theme]} tabindex={project.caseStudy ? undefined : 0} aria-labelledby={`project-title-${index}`} aria-describedby={`project-description-${index}`}>
				<div class="portfolio-artwork">
					<img class="portfolio-cover" src={project.image} alt={project.alt} width="600" height="800" loading="lazy" />
					{project.theme === "ordine" && <div class="portfolio-cover-type" aria-hidden="true"><span>Ordine.</span><span>Meno caos.<br />Più spazio.</span></div>}
					<svg class="portfolio-reveal" viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
						<defs>
							<mask id={`portfolio-mask-${index}`} maskUnits="userSpaceOnUse" x="0" y="0" width="600" height="800">
								<path class="portfolio-mask-path" d={brush} fill="none" stroke="white" stroke-width="440" stroke-linecap="round" stroke-linejoin="round" />
							</mask>
						</defs>
						<path class="portfolio-paint-path" d={brush} fill="none" stroke-width="440" stroke-linecap="round" stroke-linejoin="round" />
						<g mask={`url(#portfolio-mask-${index})`}>
							<rect width="600" height="800" class="portfolio-preview-ground" />
							<text x="40" y="115" class="portfolio-preview-name">{project.name}</text>
							<text x="42" y="157" class="portfolio-preview-label">{project.service} · concept</text>
							<image href={project.preview} x="35" y="245" width="530" height="259" preserveAspectRatio="xMinYMin meet" />
							<text x="42" y="735" class="portfolio-preview-label">{project.field}</text>
						</g>
					</svg>
				</div>
				<figcaption>
					<div class="portfolio-project-title"><h3 id={`project-title-${index}`}>{project.name}</h3><svg class="portfolio-arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
					<p id={`project-description-${index}`}>{project.service}<span>Concept · {project.year}</span></p>
				</figcaption>
				{project.caseStudy && <a class="portfolio-link" href={`/progetti/${project.slug}/`} aria-label={`Scopri il progetto ${project.name}`}></a>}
			</figure>
		))}
	</div>
	<p class="portfolio-note">Un’anteprima di ciò che potremmo costruire. Scopri il progetto Filo; gli altri concept sono anteprime.</p>
</section>
<script>
	import "../scripts/project-hover";
</script>
<style>
	.portfolio-section{--portfolio-ink:#242424;--portfolio-ease:cubic-bezier(.23,1,.32,1);padding:120px clamp(18px,4vw,64px) 90px;color:var(--portfolio-ink);background:var(--canvas);scroll-margin-top:36px}
	.portfolio-heading{display:flex;align-items:end;justify-content:space-between;gap:32px;margin:0 0 48px;padding-right:150px}
	.portfolio-heading h2{margin:0;font-size:clamp(40px,5.8vw,80px);font-weight:500;line-height:1;letter-spacing:-.04em}
	.portfolio-heading p{margin:0;max-width:390px;color:var(--gray);font-size:16px;line-height:1.5}
	.portfolio-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
	.portfolio-project{position:relative;--project-ground:#ede5db;--project-ink:#44392e;margin:0;min-width:0;outline-offset:8px}
	.portfolio-project.forma{--project-ground:#e7ece7;--project-ink:#253c33}
	.portfolio-project.ordine{--project-ground:var(--brand-tint);--project-ink:var(--brand)}
	.portfolio-project:focus-visible,.portfolio-project:focus-within{outline:2px solid var(--brand)}
	.portfolio-link{position:absolute;inset:0;z-index:2;outline:none}
	.portfolio-artwork{position:relative;aspect-ratio:3/4;overflow:hidden;background:var(--project-ground);isolation:isolate}
	.portfolio-cover{display:block;width:100%;height:100%;object-fit:cover;transition:transform 800ms var(--portfolio-ease)}
	.filo .portfolio-cover{object-position:47% center}
	.forma .portfolio-cover{object-position:62% center}
	.ordine .portfolio-cover{position:absolute;left:11%;top:43%;width:148%;height:46%;object-fit:cover;object-position:left top;transform:rotate(-8deg);transform-origin:left center}
	.portfolio-cover-type{position:absolute;inset:32px;color:var(--brand);display:flex;flex-direction:column;gap:28px;pointer-events:none}
	.portfolio-cover-type span:first-child{font-size:clamp(20px,2vw,30px);font-weight:500;letter-spacing:-.04em}
	.portfolio-cover-type span:last-child{font-size:clamp(30px,3.7vw,54px);line-height:1;letter-spacing:-.04em}
	.portfolio-reveal{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;visibility:hidden}
	.portfolio-project[data-hover-ready] .portfolio-reveal{visibility:visible}
	.portfolio-paint-path{stroke:var(--brand)}
	.portfolio-preview-ground{fill:var(--project-ground)}
	.portfolio-preview-name{font-family:inherit;font-size:62px;font-weight:500;letter-spacing:-2px;fill:var(--project-ink)}
	.portfolio-preview-label{font-family:inherit;font-size:24px;fill:var(--project-ink)}
	.portfolio-project figcaption{padding:20px 0 0}
	.portfolio-project-title{display:flex;align-items:center;justify-content:space-between;gap:16px}
	.portfolio-project h3{margin:0;font-size:clamp(24px,2.5vw,34px);line-height:1.15;letter-spacing:-.035em;font-weight:500}
	.portfolio-arrow{flex-shrink:0;transition:transform 240ms var(--portfolio-ease)}
	.portfolio-project figcaption p{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;margin:10px 0 0;font-size:16px;color:var(--gray);line-height:1.5}
	.portfolio-note{margin:40px 0 0;color:var(--gray);font-size:14px;line-height:1.5}
	@media(hover:hover) and (pointer:fine){
		.portfolio-project:hover .portfolio-cover:not(.ordine .portfolio-cover){transform:scale(1.035)}
		.portfolio-project:hover .portfolio-arrow{transform:rotate(-45deg)}
	}
	.portfolio-project:focus-visible .portfolio-arrow,.portfolio-project:focus-within .portfolio-arrow{transform:rotate(-45deg)}
	@media(max-width:900px){.portfolio-section{padding-top:80px}.portfolio-grid{gap:18px}.portfolio-heading{align-items:start;flex-direction:column;gap:20px;padding-right:0}.portfolio-project figcaption p{font-size:14px}.portfolio-cover-type{inset:20px}}
	@media(max-width:640px){.portfolio-section{padding:72px 18px 48px}.portfolio-heading{margin-bottom:32px}.portfolio-heading p{font-size:16px}.portfolio-grid{grid-template-columns:1fr;gap:36px}.portfolio-artwork{aspect-ratio:4/5}.portfolio-project h3{font-size:28px}.portfolio-project figcaption{padding-top:16px}.portfolio-project figcaption p{font-size:16px}.portfolio-cover-type{inset:30px;gap:24px}.portfolio-cover-type span:first-child{font-size:28px}.portfolio-cover-type span:last-child{font-size:48px}.portfolio-note{max-width:32ch;margin-top:32px}}
	@media(prefers-reduced-motion:reduce){.portfolio-cover,.portfolio-arrow{transition:none!important}.portfolio-project:hover .portfolio-cover,.portfolio-project:focus-visible .portfolio-arrow,.portfolio-project:focus-within .portfolio-arrow,.portfolio-project:hover .portfolio-arrow{transform:none}}
</style>
