---
import type { Project, CaseStudy } from "../../data/projects";
interface Props { project: Project & { caseStudy: CaseStudy } }
const { project } = Astro.props;
const { showcase, detail } = project.caseStudy;
---
<section class="project-gallery" aria-label="Il concept, da vicino">
	<figure class="project-showcase">
		<div class="showcase-ground">
			<img src={showcase.src} alt={showcase.alt} width={showcase.width} height={showcase.height} loading="lazy" />
		</div>
		<figcaption>{showcase.caption}</figcaption>
	</figure>
	<div class="project-detail">
		<img src={project.image} alt={project.alt} width={project.imageWidth} height={project.imageHeight} loading="lazy" />
		<div>
			<h2>{detail.title}</h2>
			<p>{detail.text}</p>
		</div>
	</div>
</section>
<style>
	.project-gallery{padding:0 clamp(20px,4vw,64px)}
	figure{margin:0}
	.showcase-ground{padding:clamp(16px,5vw,80px);background:var(--brand-tint)}
	.project-showcase img{display:block;width:100%;height:auto;max-width:1200px;margin:auto}
	figcaption{max-width:65ch;padding-top:18px;font-size:16px;line-height:1.5;color:var(--gray)}
	.project-detail{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;margin-top:clamp(64px,9vw,140px)}
	.project-detail img{display:block;width:100%;height:100%;aspect-ratio:1;object-fit:cover;object-position:center 60%}
	.project-detail>div{display:flex;flex-direction:column;justify-content:center;padding:clamp(28px,5vw,80px);background:var(--brand-tint);color:var(--brand)}
	h2{max-width:10ch;margin:0 0 28px;font-size:clamp(36px,5vw,72px);font-weight:500;line-height:1.05;letter-spacing:-.04em;text-wrap:balance}
	p{max-width:36ch;margin:0;font-size:clamp(18px,1.6vw,23px);line-height:1.55}
	@media(max-width:640px){
		.project-detail{grid-template-columns:1fr}
		.project-detail img{height:auto;max-height:460px}
		.project-detail>div{padding:36px 24px}
		h2{max-width:none;font-size:36px}
	}
</style>
