---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f7f4" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<title>{title} · LonghiDev</title>
	</head>
	<body>
		<header class="legal-header">
			<a href="/" aria-label="LonghiDev, torna alla pagina iniziale"><img src="/images/longhidev-logo.png" alt="LonghiDev" /></a>
			<a class="legal-home" href="/">← Torna al sito</a>
		</header>
		<main class="legal-content"><slot /></main>
		<SiteFooter />
	</body>
</html>

<style is:global>
	.legal-header{width:min(960px,calc(100% - 40px));height:64px;margin:20px auto;display:flex;align-items:center;justify-content:space-between}
	.legal-header img{display:block;width:60px;height:48px;object-fit:contain}
	.legal-home,.site-footer nav a{color:var(--brand);font-weight:600}
	.legal-content{width:min(760px,calc(100% - 40px));min-height:calc(100vh - 155px);margin:54px auto 80px}
	.legal-content .eyebrow{margin-bottom:10px;font-size:11px}
	.legal-content h1{margin:0 0 18px;font-size:clamp(36px,7vw,58px);line-height:1.04;letter-spacing:-.055em}
	.legal-content .updated{margin:0 0 38px;color:var(--gray);font-size:13px}
	.legal-content h2{margin:38px 0 12px;font-size:22px;letter-spacing:-.025em}
	.legal-content p,.legal-content li{font-size:15px;line-height:1.75}
	.legal-content ul{padding-left:22px}
	.legal-content a{color:var(--brand);text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
	.legal-card{margin:24px 0;padding:20px 22px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}
	.site-footer{padding:20px;display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap}
	.site-footer nav{display:flex;gap:18px;flex-wrap:wrap}
	.site-footer nav a{font-size:12px}
	@media(max-width:640px){.legal-header{width:calc(100% - 32px);margin:10px auto}.legal-content{width:calc(100% - 36px);margin:34px auto 60px}.legal-content p,.legal-content li{font-size:14px}.legal-card{padding:16px}.site-footer{gap:10px}}
</style>
