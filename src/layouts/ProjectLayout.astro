---
import "../styles/global.css";
import "../styles/navigation.css";
import ContactButton from "../components/ContactButton.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProjectHero from "../components/projects/ProjectHero.astro";
import ProjectStory from "../components/projects/ProjectStory.astro";
import ProjectGallery from "../components/projects/ProjectGallery.astro";
import type { Project, CaseStudy } from "../data/projects";
interface Props { project: Project & { caseStudy: CaseStudy } }
const { project } = Astro.props;
---
<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f7f4" />
		<meta name="description" content={project.caseStudy.description} />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<title>{project.name} — {project.service}, concept · LonghiDev</title>
	</head>
	<body>
		<a class="skip-link" href="#progetto">Vai al progetto</a>
		<a class="back-link" href="/#portfolio"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Tutti i progetti</span></a>
		<ContactButton href="/#contatto" />
		<main id="progetto">
			<ProjectHero project={project} />
			<ProjectStory project={project} />
			<ProjectGallery project={project} />
			<section class="project-closing" aria-labelledby="closing-title">
				<h2 id="closing-title">Diamo forma<br />alla tua idea.</h2>
				<div><p>Da un concept a qualcosa che puoi usare.<br />Raccontami cosa vorresti costruire.</p><a class="contact-link" href="/#contatto">Parliamo del tuo progetto</a><a class="return-link" href="/#portfolio">Torna a tutti i progetti</a></div>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>
<style>
	.back-link{position:fixed;top:24px;left:clamp(18px,4vw,64px);z-index:5;display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:12px 20px;border-radius:999px;background:var(--canvas);color:var(--brand);font-size:16px;line-height:1.4;transition:transform 160ms var(--ease-out)}
	.back-link svg{transition:transform 200ms var(--ease-out)}
	@media(hover:hover) and (pointer:fine){.back-link:hover svg{transform:translateX(-3px)}}
	.back-link:active{transform:scale(.97);transition-duration:100ms}
	.contact-link{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:12px 24px;border-radius:999px;background:var(--brand);color:var(--surface);font-size:16px;line-height:1.4;transition:transform 160ms var(--ease-out),background-color 180ms ease}
	a:focus-visible{outline:2px solid var(--brand);outline-offset:5px}
	.back-link:hover,.return-link:hover{text-decoration:underline;text-underline-offset:5px}
	.contact-link:hover{background:#4e060c}
	.contact-link:active{background:#3d0509;transform:scale(.98);transition-duration:100ms}
	.project-closing{display:grid;grid-template-columns:1.3fr 1fr;align-items:end;gap:48px;padding:clamp(80px,10vw,160px) clamp(20px,4vw,64px)}
	.project-closing h2{margin:0;color:var(--brand);font-size:clamp(36px,5.5vw,80px);font-weight:500;line-height:1.05;letter-spacing:-.04em}
	.project-closing p{margin:0 0 28px;font-size:18px;line-height:1.6}
	.return-link{display:block;width:fit-content;margin-top:20px;padding-block:8px;font-size:16px;color:var(--gray)}
	@media(max-width:640px){
		.back-link{top:16px;left:20px;gap:6px;font-size:14px}
		.project-closing{grid-template-columns:1fr;gap:28px}
	}
	@media(prefers-reduced-motion:reduce){.back-link,.back-link svg,.contact-link{transition:none}.back-link:active,.back-link:hover svg,.contact-link:active{transform:none}}
</style>
