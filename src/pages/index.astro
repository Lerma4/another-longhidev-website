---
import "../styles/global.css";
export const prerender = true;
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f7f4" />
		<meta name="description" content="LonghiDev progetta gestionali, ecommerce e siti web su misura." />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>LonghiDev — Software su misura</title>
	</head>
	<body>
		<a class="skip-link" href="#contenuto">Vai al contenuto</a>
		<header class="site-header">
			<a class="brand" href="#inizio" aria-label="LonghiDev, inizio pagina"><img src="/images/longhidev-logo.png" alt="LonghiDev" /></a>
			<nav aria-label="Navigazione principale"><a href="#lavoro">Lavoro</a><a class="nav-cta" href="#contatto">Cominciamo</a></nav>
		</header>
		<main id="contenuto">
			<section class="hero" id="inizio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">LonghiDev · software e web</p>
					<h1 id="hero-title">Sviluppo software<br />su misura.</h1>
					<p class="hero-subtitle">Per <span class="changing-word" aria-hidden="true">gestionali</span><span class="sr-only">gestionali, ecommerce e siti web</span> che semplificano il tuo lavoro.</p>
				</div>
				<div class="hero-stage">
				<div class="hero-film" id="lavoro" role="img" aria-label="Animazione dimostrativa: un gestionale, un ecommerce di ceramiche e un sito per una mostra d’arte. Nomi e dati di fantasia.">
					<hyperframes-player width="1120" height="680" loop muted disable-click-to-play assets-loading-ui="none" runtime-src="/vendor/hyperframes/runtime-0.8.171.js" aria-hidden="true" inert></hyperframes-player>
					<p class="motion-fallback">Gestionali · Ecommerce · Siti web</p>
				</div>
				</div>
				<button class="motion-toggle" type="button" aria-pressed="false" hidden>Metti in pausa l’animazione</button>
			</section>
			<section class="contact-demo" id="contatto" aria-labelledby="contact-title">
				<div><p class="eyebrow">Facciamo il primo passo</p><h2 id="contact-title">Raccontami il tuo progetto.</h2><p>Il messaggio sarà registrato per poter essere letto e ricevere una risposta. Consulta l’<a href="/privacy/">informativa privacy</a>. In alternativa, scrivi a <a href="mailto:lorenzo.longhi1995@gmail.com">lorenzo.longhi1995@gmail.com</a>.</p></div>
				<form id="contact-form">
					<label>Il tuo nome<input name="name" autocomplete="name" required minlength="2" maxlength="100" /></label>
					<label>La tua email<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
					<label>Tipo di progetto<select name="service" required><option value="" selected disabled>Scegli un'opzione</option><option>Gestionale</option><option>Ecommerce</option><option>Sito web</option><option>Non lo so ancora</option></select></label>
					<label>Due righe sul progetto<textarea name="message" rows="3" required minlength="10" maxlength="5000"></textarea></label>
					<label class="contact-trap" aria-hidden="true">Lascia vuoto<input name="website" tabindex="-1" autocomplete="off" /></label>
					<button type="submit">Invia il messaggio</button>
					<p id="form-status" aria-live="polite">I campi restano compilati se l’invio non riesce.</p>
				</form>
			</section>
		</main>
		<footer class="site-footer"><small>P. IVA 02644100063</small><nav aria-label="Informazioni legali"><a href="/note-legali/">Note legali</a><a href="/privacy/">Privacy e cookie</a></nav></footer>
		<script>import "../scripts/portfolio.ts";</script>
	</body>
</html>
