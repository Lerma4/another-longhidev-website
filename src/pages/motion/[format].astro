---
import "../../styles/global.css";
import HeroDevice from "../../components/HeroDevice.astro";
import gsapUrl from "gsap/dist/gsap.min.js?url";
export const prerender = true;
export function getStaticPaths() {
	return [{ params: { format: "desktop" } }, { params: { format: "mobile" } }];
}
const mobile = Astro.params.format === "mobile";
---
<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>LonghiDev — Hero motion</title>
	</head>
	<body class="motion-document">
		<div id="hero-motion" data-composition-id="hero-motion" data-width={mobile ? 390 : 1120} data-height={mobile ? 720 : 680} data-duration="12" data-fps="30">
			<div id="hero-device-scene" class="clip" data-start="0" data-duration="12" data-track-index="0"><HeroDevice /></div>
		</div>
		<script is:inline src={gsapUrl}></script>
		<script is:inline>
			window.__timelines ??= {};
			// HyperFrames screen-flow-carousel: shared direction, fast throw, soft catch.
			// One finite, seekable timeline; playback and looping belong to the player.
			const sequence = gsap.timeline({ paused: true });
			const timeline = {
				set: (...args) => sequence.set(...args),
				to: (...args) => sequence.to(...args),
				fromTo: (...args) => sequence.fromTo(...args),
			};
			const scenes = [...document.querySelectorAll("[data-view]")];
			const captions = [...document.querySelectorAll("[data-caption]")];
			const detailSelectors = [".stats > div, .table > div", ".product-photo, .shop-content > div", ".exhibition-photo, .art-copy"];
			scenes.forEach((scene, index) => {
				const start = index === 0 ? 0 : index * 6 - .55;
				timeline.set(scene, { opacity: index === 0 ? 1 : 0, xPercent: index === 0 ? 0 : 12, scale: index === 0 ? 1 : .96 }, 0);
				timeline.set(captions[index], { opacity: index === 0 ? 1 : 0, y: index === 0 ? 0 : 14 }, 0);
				if (index > 0) {
					timeline.to(scene, { xPercent: 0, scale: 1, opacity: 1, duration: .8, ease: "power4.out" }, start);
					timeline.to(captions[index], { y: 0, opacity: 1, duration: .5, ease: "power3.out" }, start + .1);
				}
				const details = scene.querySelectorAll(detailSelectors[index]);
				if (index > 0) {
					// Prepare while hidden; never reset visible content when its tween starts.
					timeline.set(details, { y: 22, opacity: 0 }, 0);
					timeline.to(details, { y: 0, opacity: 1, duration: .65, stagger: .07, ease: "power3.out" }, start + .2);
				}
				timeline.to(scene, { xPercent: -10, scale: .97, opacity: 0, duration: .55, ease: "power3.inOut" }, index * 6 + 5.45);
				timeline.to(captions[index], { y: -12, opacity: 0, duration: .3, ease: "power2.in" }, index * 6 + 5.6);
			});
			// Small scripted product stories, not clickable mock interfaces.
			const orderCount = document.querySelector(".stats strong");
			timeline.set(orderCount, { textContent: "24" }, 0);
			timeline.to(orderCount, { textContent: 25, snap: { textContent: 1 }, duration: .5, ease: "power2.out" }, 1.5);
			timeline.set(".table > div", { x: 16, opacity: 0 }, 0);
			timeline.to(".table > div", { x: 0, opacity: 1, stagger: .1, duration: .6, ease: "power3.out" }, .2);
			// Reset under the hidden first scene, before it returns across the loop seam.
			timeline.set(".table > div", { x: 16, opacity: 0 }, 17.4);
			timeline.set(orderCount, { textContent: "24" }, 17.4);
			const cartButton = document.querySelector(".shop-content button");
			const cartCount = document.querySelector("[data-cart-count]");
			timeline.set(cartButton, { textContent: "Aggiungi al carrello" }, 0);
			timeline.set(cartCount, { textContent: "0" }, 0);
			timeline.to(cartButton, { scale: .96, duration: .15, ease: "power2.inOut" }, 8.2);
			timeline.to(cartButton, { scale: 1, duration: .3, ease: "power3.out" }, 8.35);
			timeline.set(cartButton, { textContent: "Aggiunto al carrello ✓" }, 8.35);
			timeline.set(cartCount, { textContent: "1" }, 8.35);
			timeline.fromTo(".cart-indicator", { scale: 1.2 }, { scale: 1, duration: .4, immediateRender: false }, 8.35);
			timeline.set(".exhibition-photo", { scale: 1.06 }, 0);
			timeline.to(".exhibition-photo", { scale: 1, duration: 1.4, ease: "power3.out" }, 11.65);
			// Reassemble the first scene before the seam so the 18s loop has no hard cut.
			timeline.fromTo(scenes[0], { xPercent: 12, scale: .96, opacity: 0 }, { xPercent: 0, scale: 1, opacity: 1, duration: .55, ease: "power3.out", immediateRender: false }, 17.45);
			timeline.fromTo(captions[0], { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: .4, immediateRender: false }, 17.6);
			const master = gsap.timeline({ paused: true });
			master.to(sequence, { progress: 1, duration: 12, ease: "none" }, 0);
			window.__timelines["hero-motion"] = master;
			const runtime = document.createElement("script");
			runtime.src = "/vendor/hyperframes/runtime-0.8.171.js";
			document.body.append(runtime);
		</script>
	</body>
</html>
<style is:global>
	html:has(.motion-document){background:transparent}
	.motion-document{min-width:0;min-height:0;overflow:hidden;background:transparent}
	#hero-motion{width:100%;height:100%;position:absolute;inset:0}
	#hero-motion>.clip{position:absolute;inset:0;padding:18px 45px 50px}
	.motion-document .laptop{width:100%;margin:0;perspective:none}
	.motion-document .views{height:490px;overflow:hidden}
	.motion-document .view{position:absolute;inset:0;min-height:100%;opacity:0;transform:none;filter:none;transition:none;pointer-events:none}
	.motion-document .view-admin{opacity:1}
	.motion-document .screen{box-shadow:0 18px 40px #25040a24}
	.motion-document .window-dots{color:#747271}
	.motion-document .shop-content button{transition:none}
	.motion-document .concept-note{display:block;margin-top:10px;font-size:10px}
	.motion-document .screen-footer{min-height:55px}
	.motion-captions{position:relative;width:180px;height:30px;overflow:hidden;color:var(--brand);font-size:13px;font-weight:600}
	.motion-captions>[data-caption]{position:absolute;inset:0;display:flex;align-items:center;justify-content:flex-end;gap:6px;opacity:0}
	.motion-captions>[data-caption="0"]{opacity:1}
	.motion-document button{pointer-events:none;opacity:1}
	@media(max-width:640px){
		#hero-motion>.clip{padding:10px 20px 30px}
		.motion-document .laptop{width:350px;margin:0}
		.motion-document .views{height:510px;min-height:510px;overflow:hidden}
		.motion-document .view{height:510px}
		.motion-document .view-art header nav{display:none}
		.motion-document .screen-footer{display:flex;flex-direction:column;gap:4px;min-height:66px;padding:9px 2px;border-radius:0 0 7px 7px}
		.motion-captions{height:26px;width:100%;font-size:13px}
		.motion-captions>[data-caption]{justify-content:center}
	}
</style>
